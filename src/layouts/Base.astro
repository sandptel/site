---
import '../styles/global.css';
import themes from '../data/themes.json';

interface Props {
  title?: string;
  description?: string;
  wash?: boolean; // mood washes, for posts
}
const { title, description = 'Sandeep Patel: Rust, Nix and Wayland. Systems work, written so it branches as you read.', wash = false } = Astro.props;
const fullTitle = title ? `${title} · Sandeep Patel` : 'Sandeep Patel';
const nav = [
  ['/#journey', 'journey'],
  ['/projects', 'projects'],
  ['/writing', 'writing'],
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href !== '/#journey' && here.startsWith(href) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <!-- before first paint: saved theme, else the OS mode -->
    <script is:inline>
      (() => {
        const r = document.documentElement; r.classList.add('js');
        let m, s; try { m = localStorage.getItem('mode'); s = localStorage.getItem('scheme'); } catch {}
        r.dataset.mode = m || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        r.dataset.scheme = s || 'marginalia';
        if (/[?&]all|#all/.test(location.search + location.hash)) r.classList.add('all');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Young+Serif&display=swap" />
  </head>
  <body>
    {wash && <><div class="wash ember" aria-hidden="true"></div><div class="wash lichen" aria-hidden="true"></div></>}
    <header class="top">
      <a class="mark" href="/">sand<span>ptel</span></a>
      <!-- now reading: compass for direction, the stop's mark, what it is, and how far down the page you are -->
      <div class="nowr" aria-hidden="true">
        <span class="nr-dial"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /><g class="needle"><path class="nb" d="M12 3.5 L14 12 L12 20.5 L10 12 Z" /><path class="nt" d="M12 3.5 L14 12 L10 12 Z" /></g></svg></span>
        <span class="nr-seal"></span>
        <span class="nr-text"><span class="nr-name"><i class="arr"></i><b></b></span><small class="nr-desc"></small></span>
        <span class="explored" hidden title="Branches you've opened on this page">
          <svg viewBox="0 0 20 20"><circle class="trk" cx="10" cy="10" r="7.5" /><circle class="val" cx="10" cy="10" r="7.5" pathLength="1" /></svg>
          <span><b data-explored>0</b><span class="sep">/</span><span data-explore-total>0</span></span>
        </span>
        <span class="nr-track"><i></i></span>
      </div>
      <div class="right">
        <nav aria-label="Primary">
          <ul>{nav.map(([href, label]) => <li><a href={href} aria-current={current(href)}>{label}</a></li>)}</ul>
        </nav>
        <div class="theme">
          <button class="mode" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <svg class="sunmoon" viewBox="0 0 24 24" aria-hidden="true">
              <mask id="sm-bite"><rect width="24" height="24" fill="#fff" /><circle class="bite" cx="30" cy="-6" r="7" fill="#000" /></mask>
              <circle class="disc" cx="12" cy="12" r="4.5" mask="url(#sm-bite)" />
              <g class="rays"><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></g>
            </svg>
          </button>
          <button class="scheme" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Choose a base16 theme">
            <span class="dots"></span><span class="nm">Marginalia</span>
          </button>
          <ul class="schemes" role="listbox" aria-label="base16 themes" hidden>
            {themes.map(t => (
              <li role="option" tabindex="-1" data-id={t.id} data-label={t.label} data-light={JSON.stringify(t.light.swatch)} data-dark={JSON.stringify(t.dark.swatch)}>
                <span>{t.label}</span>
                <span class="strip" aria-hidden="true">
                  {t.light.swatch.slice(0, 1).concat(t.light.swatch.slice(3)).map(c => <i style={`background:${c}`}></i>)}
                  {t.dark.swatch.slice(0, 1).concat(t.dark.swatch.slice(3)).map(c => <i style={`background:${c}`}></i>)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <span class="sig">Sandeep Patel</span>
      <span class="contact mono">
        <span>sandppatel15@gmail.com</span>
        <a href="https://github.com/sandptel">github ↗</a>
        <a href="https://linkedin.com/in/sandptel">linkedin ↗</a>
      </span>
      <span class="mono">I use NixOS, btw · press <kbd>?</kbd> for keys</span>
    </footer>
    <div class="keys-help" role="dialog" aria-modal="true" aria-labelledby="keys-h" hidden>
      <div class="kh-card">
        <p class="kicker" id="keys-h">keyboard</p>
        <dl>
          <div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>next / previous stop, or paragraph that branches</dd></div>
          <div><dt><kbd>x</kbd></dt><dd>open or fold the card you're on</dd></div>
          <div><dt><kbd>t</kbd></dt><dd>next base16 theme</dd></div>
          <div><dt><kbd>d</kbd></dt><dd>light / dark</dd></div>
          <div><dt><kbd>g</kbd></dt><dd>rewind to the top</dd></div>
          <div><dt><kbd>esc</kbd></dt><dd>close this, or fold a branch</dd></div>
        </dl>
      </div>
    </div>
    <script>
      import '../scripts/site.js';
      import '../scripts/branches.js';
    </script>
  </body>
</html>
