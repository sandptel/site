---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/ui';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing">
  <section class="list-page wrap">
    <h1>Writing</h1>
    <p>So far, my two GSoC reports, rewritten to be easier to read. Dotted words open a short note.</p>
    <ul class="entries">
      {posts.map(p => (
        <li><a class="row" href={withBase(`/writing/${p.id}`)}><span class="t">{p.data.title}</span><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time>{p.data.summary && <span class="s">{p.data.summary}</span>}</a></li>
      ))}
    </ul>
  </section>
</Base>
