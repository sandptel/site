---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing">
  <section class="list-page wrap">
    <p class="kicker">writing</p>
    <h1>Posts that branch</h1>
    <p>Long-form notes from the work. Unfamiliar words grow explanations as you scroll.</p>
    <ul class="entries">
      {posts.map(p => (
        <li><a class="row" href={`/writing/${p.id}`}><span class="t">{p.data.title}</span><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time>{p.data.summary && <span class="s">{p.data.summary}</span>}</a></li>
      ))}
    </ul>
  </section>
</Base>
