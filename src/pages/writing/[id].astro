---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { weave, withBase, icon, seal, inline } from '../../lib/ui';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { repo, project, marks, glance } = post.data;
const sections = (post.rendered?.metadata?.headings ?? []).filter((h: any) => h.depth === 2);
// branches are woven into the rendered markdown at build time, so they exist without JS
const body = weave(post.rendered?.html ?? '', post.data.branches);
---
<Base title={post.data.title} description={post.data.summary} wash>
  <article class="grove" data-grove>
    <svg class="roots" aria-hidden="true"></svg>
    <header class="col post-head">
      {(repo || project) && (
        <p class="src-links mono">
          {repo && <a class="repo-top" href={repo}><Fragment set:html={icon('github')} /><span>{repo.replace(/^https:\/\/github\.com\//, '')}</span><i aria-hidden="true">↗</i></a>}
          {project && <a class="repo-top" href={project}><Fragment set:html={icon('googlesummerofcode')} /><span>GSoC project page</span><i aria-hidden="true">↗</i></a>}
        </p>
      )}
      {marks.length > 0 && <p class="marks" aria-hidden="true" set:html={marks.map(m => seal(m)).join('<i></i>')} />}
      <p class="kicker">writing</p>
      <h1>{post.data.title}</h1>
      <p class="dateline mono">{post.data.dateline ?? post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</p>
      {glance.length > 0 && <dl class="glance">{glance.map(([k, v]) => <div><dt class="mono">{k}</dt><dd set:html={inline(v)} /></div>)}</dl>}
      {sections.length > 1 && (
        <nav class="toc mono" aria-label="In this post">
          <ol>{sections.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </header>
    <div class="col body" set:html={body} />
    <footer class="col post-foot mono">
      <a href={withBase('/writing')}>← all writing</a>
      {repo && <a href={repo}>the original report ↗</a>}
      <a href={withBase('/#journey')}>where this sits in the journey →</a>
    </footer>
  </article>
</Base>
