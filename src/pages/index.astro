---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { JOURNEY, NICHES, nicheCount, GITHUB, LINKEDIN, EMAIL, type Niche } from '../data/journey';
import { icon, seal, renderBranch } from '../lib/ui';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// the places this tree passed through; each one jumps to its stop
const PLACES = [
  { seal: 'iitkgp', name: 'IIT Kharagpur', meta: '2021 — 2026', note: 'Dual degree, M.Tech + B.Tech', to: 'iit' },
  { seal: 'gsoc', name: 'Google Summer of Code', meta: '2024 · 2025', note: 'Two summers, both with CCExtractor', to: 'gsoc24' },
  { seal: 'ccx', name: 'CCExtractor', meta: 'mentoring org', note: 'Regolith on NixOS, then on COSMIC', to: 'gsoc25' },
  { seal: 'regolith', name: 'Regolith', meta: '1.2k★ · maintainer', note: 'Core maintainer of regolith-nix', to: 'nixwild' },
  { seal: 'mecha', name: 'Mecha Systems', meta: 'Jul 2025 — Jan 2026', note: 'Rust developer on the Comet shell', to: 'mecha' },
  { seal: 'nixos', name: 'nixpkgs', meta: '9+ derivations', note: 'Upstream packages and modules', to: 'nixwild' },
  { seal: 'popos', name: 'COSMIC', meta: '4.4k★ · contributor', note: 'Applets, settings, flakes', to: 'cosmic' },
  { seal: 'rust', name: 'cargo-semver-checks', meta: '1.5k★ · contributor', note: 'Witness hints for lints', to: 'semver' },
  { seal: 'rkhall', name: 'RK Hall', meta: 'GSec Technology', note: '10 teams, GC gold twice', to: 'rkhall' },
];

// LinkedIn has no Simple Icons mark, so a plain drawn one
const LI = '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.4 10.2v6.4M7.4 7.4v.1M11 16.6v-6.4M11 13c0-1.8 1-2.9 2.6-2.9s2.4 1 2.4 2.9v3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
const MAIL = '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<Base>
  <section class="hero wrap" id="hero">
    <svg class="wander" aria-hidden="true"><path class="w-main" pathLength="1" /><circle r="2.6" cx="-10" cy="-10" /></svg>
    <div>
      <p class="chips mono rise" style="--d:0">
        {[['rust', 'Rust'], ['nixos', 'Nix / NixOS'], ['wayland', 'Wayland'], ['linux', 'Linux desktop']].map(([n, t]) => <span><Fragment set:html={icon(n)} />{t}</span>)}
      </p>
      <h1 class="name" aria-label="Sandeep Patel"><span class="l rise" style="--d:1">Sandeep</span><span class="l l2 rise" style="--d:2">Patel</span></h1>
      <p class="bio rise" style="--d:3" aria-label="Can't perceive directions"><span class="w1">Can't</span> <span class="w2">perceive</span> <span class="w3" id="bio-end">directions</span></p>
      <p class="intro rise" style="--d:4">
        I build the parts of Linux you touch but rarely see: <button class="tw demo-tw" type="button" data-def="compositor" aria-describedby="hero-branch">compositors</button>, shells, and the <button class="tw demo-tw" type="button" data-def="daemon" aria-describedby="hero-branch">daemons</button> between them, in Rust, reproducible with <button class="tw demo-tw" type="button" data-def="nix" aria-describedby="hero-branch">Nix</button>.
      </p>
      <p class="creds mono rise" style="--d:5"><span>2× Google Summer of Code</span><span>the shell of Mecha's Comet handheld</span><span>dual degree, IIT Kharagpur</span></p>
      <ul class="reach rise" style="--d:6" aria-label="Elsewhere">
        <li><a href={GITHUB}><Fragment set:html={icon('github')} /><span>github.com/<b>sandptel</b></span><i aria-hidden="true">↗</i></a></li>
        <li><a href={LINKEDIN}><Fragment set:html={LI} /><span>linkedin.com/in/<b>sandptel</b></span><i aria-hidden="true">↗</i></a></li>
        <li><button type="button" class="copy" data-copy={EMAIL}><Fragment set:html={MAIL} /><span>{EMAIL}</span><i aria-hidden="true">copy</i></button></li>
      </ul>
      <a class="now mono rise" style="--d:7" href="https://github.com/sandptel/wado">
        <span class="now-row"><span class="live" aria-hidden="true"></span><span class="now-t">now · <b>building wado</b>, a headless Wayland compositor that streams over WebRTC</span></span>
        <span class="now-x"><span class="now-in"><span class="gh"><Fragment set:html={icon('github')} /><span>github.com/sandptel/<b>wado</b></span></span><span class="tags"><i>Rust</i><i>Smithay</i><i>VA-API</i><i>pre-alpha</i></span><i class="now-arr" aria-hidden="true">↗</i></span></span>
      </a>
      <br />
      <a class="hint mono" href="#journey"><svg viewBox="0 0 16 26" aria-hidden="true"><path d="M8 1 C 4 8, 12 12, 8 24 M3 19 L8 24 L13 18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg><span class="hint-t">this way, probably</span></a>
      <div class="hero-branch" id="hero-branch" role="tooltip">
        <svg class="hb-line" aria-hidden="true"><path pathLength="1" /></svg>
        <div class="card t-define" data-for="compositor"><p class="ctype"><span class="g"></span>define</p><h3>compositor<em>n.</em></h3><p>The program that draws every window and routes your input to it. On Wayland, it is the display server.</p></div>
        <div class="card t-define" data-for="daemon"><p class="ctype"><span class="g"></span>define</p><h3>daemon<em>n.</em></h3><p>A program with no window. It starts with your session, listens, and acts when something changes.</p></div>
        <div class="card t-define" data-for="nix"><p class="ctype"><span class="g"></span>define</p><h3>Nix<em>n.</em></h3><p>A package manager and build language whose builds come out the same on every machine. NixOS is a whole system declared in it.</p></div>
      </div>
    </div>
    <a class="compass rise" style="--d:4" href="#journey" aria-label="Jump to the journey">
      <svg viewBox="0 0 132 132">
        <circle class="ring" cx="66" cy="66" r="58" />
        <circle class="ring" cx="66" cy="66" r="44" stroke-dasharray="2 5" />
        <g class="tick"><line x1="66" y1="4" x2="66" y2="12" /><line x1="66" y1="120" x2="66" y2="128" /><line x1="4" y1="66" x2="12" y2="66" /><line x1="120" y1="66" x2="128" y2="66" /></g>
        <text x="66" y="22">N</text><text x="112" y="66">E</text><text x="66" y="111">S</text><text x="20" y="66">W</text>
        <g class="needle"><path class="n-body" d="M66 26 L71 66 L66 106 L61 66 Z" stroke-width="1" /><path class="n-tip" d="M66 26 L71 66 L61 66 Z" /><circle cx="66" cy="66" r="2.5" fill="currentColor" /></g>
      </svg>
      <span class="cap" aria-hidden="true">heading: <b>unsure</b></span>
    </a>
  </section>


  <section id="journey" class="grove journey" data-grove data-journey aria-labelledby="journey-h">
    <svg class="roots" aria-hidden="true"></svg>
    <header class="jhead" data-nr data-name="Journey" data-desc={`2021 → now, ${JOURNEY.length} stops on one trunk`}>
      <p class="kicker">journey</p>
      <h2 id="journey-h">2021 → now</h2>
      <p class="mono">one trunk, many branches</p>
      <ul class="niches" aria-label="Filter by niche">
        {(Object.keys(NICHES) as Niche[]).map(k => (
          <li>
            <button type="button" aria-pressed="false" data-niche={k}>
              <span class="icos" set:html={NICHES[k].icons.map(n => icon(n)).join('')} />
              {NICHES[k].label}<span class="n">{nicheCount(k)}</span>
            </button>
          </li>
        ))}
      </ul>
    </header>
    <div class="jcol">
      {JOURNEY.map(s => (
        <div class="stop" id={`stop-${s.id}`} data-tags={s.tags.join(' ')} data-name={s.what} data-nr data-desc={Object.values(s.cards)[0].gist ?? Object.values(s.cards)[0].body}>
          <button class="node" type="button" data-b={Object.keys(s.cards).join(' ')}>
            {s.seal && <Fragment set:html={seal(s.seal)} />}
            <span><span class="yr">{s.when}</span><span class="what">{s.what}</span></span>
          </button>
          <div class="slot" set:html={Object.entries(s.cards).map(([id, b]) => renderBranch(id, b)).join('')} />
        </div>
      ))}
    </div>
  </section>

  <section class="list-page wrap home-writing" aria-labelledby="writing-h" data-nr data-name="Writing" data-desc="Posts that branch as you read them">
    <p class="kicker">writing</p>
    <h2 id="writing-h" class="sec-h">Posts that branch</h2>
    <ul class="entries">
      {posts.map(p => (
        <li><a class="row" href={`/writing/${p.id}`}><span class="t">{p.data.title}</span><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time>{p.data.summary && <span class="s">{p.data.summary}</span>}</a></li>
      ))}
    </ul>
  </section>
  <section class="places wrap" id="places" aria-labelledby="places-h" data-nr data-name="Places" data-desc="Every organisation on the tree, in one wall">
    <h2 id="places-h">Places the tree passed through</h2>
    <p>Everywhere above, in one wall.</p>
    <ul class="wall">
      {PLACES.map((p, i) => (
        <li style={`--i:${i}`}>
          <a href={`#stop-${p.to}`}>
            <Fragment set:html={seal(p.seal)} />
            <span class="who"><b>{p.name}</b><small>{p.meta}</small><em>{p.note}</em></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="coda wrap" aria-labelledby="coda-h" data-nr data-name="End of the tree" data-desc="For now. Rewind it, or open what you skipped">
    <p class="kicker" id="coda-h">end of the tree, for now</p>
    <p class="coda-line">You opened <b data-explored>0</b> of <span data-explore-total>0</span> branches on this page. <span class="coda-more">Every dotted word, card and node has more folded inside.</span></p>
    <button class="rewind" type="button">rewind the tree <span aria-hidden="true">↑</span></button>
  </section>
</Base>
