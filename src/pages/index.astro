---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { JOURNEY, NICHES, nicheCount, GITHUB, LINKEDIN, EMAIL, type Niche } from '../data/journey';
import { icon, seal, renderBranch, withBase } from '../lib/ui';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// the places this tree passed through; each one jumps to its stop
const PLACES = [
  { seal: 'iitkgp', name: 'IIT Kharagpur', meta: '2021 — 2026', note: 'Dual degree, M.Tech + B.Tech', to: 'iit' },
  { seal: 'gsoc', name: 'Google Summer of Code', meta: '2024 · 2025', note: 'Two summers, both with CCExtractor', to: 'gsoc24' },
  { seal: 'ccx', name: 'CCExtractor', meta: 'mentoring org', note: 'Regolith on NixOS, then on COSMIC', to: 'gsoc25' },
  { seal: 'regolith', name: 'Regolith', meta: '1.2k★ · maintainer', note: 'Core maintainer of regolith-nix', to: 'nixwild' },
  { seal: 'mecha', name: 'Mecha Systems', meta: 'Jul 2025 — Jan 2026', note: 'Rust developer on the Comet shell', to: 'mecha' },
  { seal: 'nixos', name: 'nixpkgs', meta: '9+ derivations', note: 'Upstream packages and modules', to: 'nixwild' },
  { seal: 'popos', name: 'COSMIC', meta: '4.4k★ · contributor', note: 'Applets, settings, flakes', to: 'cosmic' },
  { seal: 'rust', name: 'cargo-semver-checks', meta: '1.5k★ · contributor', note: 'Witness hints for lints', to: 'semver' },
  { seal: 'rkhall', name: 'RK Hall', meta: 'GSec Technology', note: '10 teams, GC gold twice', to: 'rkhall' },
];

// hero terms: a dotted word that grows a small card (see .hero-branch below)
// a span (not a <button>) so long terms wrap across lines like the prose around them; site.js gives it button keys
const T = (id: string, text: string) => `<span class="tw demo-tw" role="button" tabindex="0" data-def="${id}" aria-describedby="hero-branch">${text}</span>`;
const A = (href: string, text: string) => `<a href="${withBase(href)}">${text}</a>`;
// the two faces of the bio: the photo shows the academic side, the GitHub avatar the programming side
const FACE_A = [
  `Hi, I'm <b class="me">Sandeep Patel</b>. I'm completing a five-year dual degree, B.Tech and M.Tech, at ${T('iitkgp', 'IIT Kharagpur')}, where most of my time outside class went to ${T('rkhall', 'Radhakrishnan Hall')}.`,
  `In 2023–24 I was the hall's ${T('gsec', 'General Secretary of Technology')}, organising its teams across the inter-hall ${T('gc', 'Technology General Championship')}; RK Hall took gold twice during my years there. Earlier, I wrote technical articles for ${T('unstop', 'Unstop')} and spent a summer as a research intern at the ${T('coeamt', 'Centre of Excellence in Advanced Manufacturing')}.`,
];
const FACE_B = [
  `Hi, I'm <b class="me">Sandeep Patel</b>. I work on the Linux desktop: ${T('compositor', 'compositors')}, shells, and the ${T('daemon', 'daemons')} between them, mostly in Rust and built with ${T('nix', 'Nix')}.`,
  `Over two ${T('gsoc', 'Google Summers of Code')} with ${T('ccx', 'CCExtractor')} I brought the Regolith desktop to NixOS and then onto ${T('cosmic', 'COSMIC')}, and I worked on the shell of ${T('mecha', 'Mecha')}'s Comet handheld. These days I'm building ${T('wado', 'wado')}.`,
];
const TERMS: { id: string; seal?: string; title: string; body: string; href?: string }[] = [
  { id: 'iitkgp', seal: 'iitkgp', title: 'IIT Kharagpur', body: 'The first of the Indian Institutes of Technology, founded in 1951. Dual degree, 2021 to 2026.', href: 'https://www.iitkgp.ac.in' },
  { id: 'rkhall', seal: 'rkhall', title: 'Radhakrishnan Hall', body: 'One of the residential halls at IIT Kharagpur. Halls compete with each other all year, in sport, culture and technology.', href: 'https://www.rkhall.in' },
  { id: 'gsec', seal: 'rkhall', title: 'General Secretary, Technology', body: 'The elected student who runs a hall\'s technology events for the year: choosing captains, building teams, managing the budget.' },
  { id: 'gc', title: 'General Championship', body: 'IIT Kharagpur\'s year-long contest between halls. Technology is one of its tracks, with events from quizzes to hardware modelling.' },
  { id: 'unstop', title: 'Unstop', body: 'A platform for student competitions and hiring. Technical writing internship, May to July 2023.', href: 'https://unstop.com' },
  { id: 'coeamt', seal: 'iitkgp', title: 'CoE, Advanced Manufacturing', body: 'IIT Kharagpur\'s Centre of Excellence in Advanced Manufacturing Technology. Research internship, 2023.', href: 'https://coeamt.iitkgp.ac.in' },
  { id: 'compositor', title: 'compositor', body: 'The program that draws every window and routes your input to it. On Wayland, it is the display server.' },
  { id: 'daemon', title: 'daemon', body: 'A program with no window. It starts with your session, listens, and acts when something changes.' },
  { id: 'nix', seal: 'nixos', title: 'Nix', body: 'A package manager and build language whose builds come out the same on every machine. NixOS is a whole system declared in it.', href: 'https://nixos.org' },
  { id: 'gsoc', seal: 'gsoc', title: 'Google Summer of Code', body: 'Google\'s programme that pairs students with open-source organisations for a summer of paid work. 2024 and 2025.', href: 'https://summerofcode.withgoogle.com' },
  { id: 'ccx', seal: 'ccx', title: 'CCExtractor', body: 'An open-source organisation, best known for subtitle extraction, that mentors GSoC projects across many codebases.', href: 'https://ccextractor.org' },
  { id: 'cosmic', seal: 'popos', title: 'COSMIC', body: 'System76\'s new desktop environment, written in Rust.', href: 'https://system76.com/cosmic' },
  { id: 'mecha', seal: 'mecha', title: 'Mecha', body: 'The team behind the Comet, an open and modular Linux handheld. I worked on its shell, Jul 2025 to Jan 2026.', href: 'https://mecha.so' },
  { id: 'wado', seal: 'wayland', title: 'wado', body: 'A headless Wayland compositor that streams its display to a browser over WebRTC.', href: 'https://github.com/sandptel/wado' },
];

---
<Base>
  <section class="hero wrap" id="hero">
    <svg class="wander" aria-hidden="true"><path class="w-main" pathLength="1" /><circle r="2.6" cx="-10" cy="-10" /></svg>
    <h1 class="sr">Sandeep Patel</h1>
    <div class="about-wrap">
      <div class="about rise" style="--d:0">
        <figure class="me-card" data-face="a">
          <button class="flip" type="button" aria-pressed="false" aria-label="Turn the photo: academic side or programming side">
            <span class="flip-in">
              <span class="face front"><img src={withBase('/me/linkedin.jpg')} alt="Sandeep Patel" width="400" height="400" fetchpriority="high" decoding="async" /></span>
              <span class="face back"><img src={withBase('/me/github.jpg')} alt="Roronoa Zoro, Sandeep's GitHub avatar" width="400" height="400" decoding="async" /></span>
            </span>
          </button>
          <figcaption class="mono"><span class="cap-a"><Fragment set:html={seal('iitkgp')} />IIT Kharagpur</span><span class="cap-b"><Fragment set:html={icon('github')} />sandptel</span></figcaption>
        </figure>
        <div class="faces">
          <div class="face-text fa">{FACE_A.map(p => <p set:html={p} />)}</div>
          <div class="face-text fb" inert>{FACE_B.map(p => <p set:html={p} />)}</div>
        </div>
      </div>
      <p class="about-more rise" style="--d:2">Both GSoC projects are <Fragment set:html={A('/writing', 'written up properly')} />, and the <a href="#journey">journey below</a> has everything else. You can find me on <a href={GITHUB}>GitHub</a> and <a href={LINKEDIN}>LinkedIn</a>, or write to <button type="button" class="copy inline" data-copy={EMAIL}><span>{EMAIL}</span><i aria-hidden="true">copy</i></button>.</p>
      <a class="now mono rise" style="--d:3" href="https://github.com/sandptel/wado">
        <span class="now-row"><span class="live" aria-hidden="true"></span><span class="now-t">now · <b>building wado</b>, a headless Wayland compositor that streams over WebRTC</span></span>
        <span class="now-x"><span class="now-in"><span class="gh"><Fragment set:html={icon('github')} /><span>github.com/sandptel/<b>wado</b></span></span><span class="tags"><i>Rust</i><i>Smithay</i><i>VA-API</i><i>pre-alpha</i></span><i class="now-arr" aria-hidden="true">↗</i></span></span>
      </a>
      <br />
      <a class="hint mono" href="#journey"><svg viewBox="0 0 16 26" aria-hidden="true"><path d="M8 1 C 4 8, 12 12, 8 24 M3 19 L8 24 L13 18" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg><span class="hint-t">this way, probably</span></a>
      <div class="hero-branch" id="hero-branch" role="tooltip">
        <svg class="hb-line" aria-hidden="true"><path pathLength="1" /></svg>
        {TERMS.map(t => (
          <div class="card t-define" data-for={t.id} hidden>
            <header class="hb-h">{t.seal && <Fragment set:html={seal(t.seal)} />}<div><p class="ctype"><span class="g"></span>{t.seal ? 'about' : 'define'}</p><h3>{t.href ? <a class="h-link" href={t.href}>{t.title}<span class="arr" aria-hidden="true">↗</span></a> : t.title}</h3></div></header>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
    <a class="compass rise" style="--d:4" href="#journey" aria-label="Jump to the journey">
      <svg viewBox="0 0 132 132">
        <circle class="ring" cx="66" cy="66" r="58" />
        <circle class="ring" cx="66" cy="66" r="44" stroke-dasharray="2 5" />
        <g class="tick"><line x1="66" y1="4" x2="66" y2="12" /><line x1="66" y1="120" x2="66" y2="128" /><line x1="4" y1="66" x2="12" y2="66" /><line x1="120" y1="66" x2="128" y2="66" /></g>
        <text x="66" y="22">N</text><text x="112" y="66">E</text><text x="66" y="111">S</text><text x="20" y="66">W</text>
      </svg>
      <!-- the needle is its own layer: turning it is compositor work only, no SVG relayout per frame -->
      <svg class="needle-svg" viewBox="0 0 132 132" aria-hidden="true"><g class="needle"><path class="n-body" d="M66 26 L71 66 L66 106 L61 66 Z" stroke-width="1" /><path class="n-tip" d="M66 26 L71 66 L61 66 Z" /><circle cx="66" cy="66" r="2.5" fill="currentColor" /></g></svg>
      <span class="cap" aria-hidden="true">heading: <b>unsure</b></span>
    </a>
  </section>


  <section id="journey" class="grove journey" data-grove data-journey aria-labelledby="journey-h">
    <svg class="roots" aria-hidden="true"></svg>
    <header class="jhead" data-nr data-name="Journey" data-desc={`2021 → now, ${JOURNEY.length} stops`}>
      <p class="kicker">journey</p>
      <h2 id="journey-h">2021 → now</h2>
      <p class="mono">oldest first</p>
      <ul class="niches" aria-label="Filter by niche">
        {(Object.keys(NICHES) as Niche[]).map(k => (
          <li>
            <button type="button" aria-pressed="false" data-niche={k}>
              <span class="icos" set:html={NICHES[k].icons.map(n => icon(n)).join('')} />
              {NICHES[k].label}<span class="n">{nicheCount(k)}</span>
            </button>
          </li>
        ))}
      </ul>
    </header>
    <div class="jcol">
      {JOURNEY.map(s => (
        <div class="stop" id={`stop-${s.id}`} data-tags={s.tags.join(' ')} data-name={s.what} data-nr data-desc={Object.values(s.cards)[0].gist ?? Object.values(s.cards)[0].body}>
          <button class="node" type="button" data-b={Object.keys(s.cards).join(' ')}>
            {s.seal && <Fragment set:html={seal(s.seal)} />}
            <span><span class="yr">{s.when}</span><span class="what">{s.what}</span></span>
          </button>
          <div class="slot" set:html={Object.entries(s.cards).map(([id, b]) => renderBranch(id, b)).join('')} />
        </div>
      ))}
    </div>
  </section>

  <section class="list-page wrap home-writing" aria-labelledby="writing-h" data-nr data-name="Writing" data-desc="The two GSoC write-ups">
    <p class="kicker">writing</p>
    <h2 id="writing-h" class="sec-h">Writing</h2>
    <ul class="entries">
      {posts.map(p => (
        <li><a class="row" href={withBase(`/writing/${p.id}`)}><span class="t">{p.data.title}</span><time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</time>{p.data.summary && <span class="s">{p.data.summary}</span>}</a></li>
      ))}
    </ul>
  </section>
  <section class="places wrap" id="places" aria-labelledby="places-h" data-nr data-name="Places" data-desc="Organisations, in one place">
    <h2 id="places-h">Places</h2>
    <p>Where the work above happened.</p>
    <ul class="wall">
      {PLACES.map((p, i) => (
        <li style={`--i:${i}`}>
          <a href={`#stop-${p.to}`}>
            <Fragment set:html={seal(p.seal)} />
            <span class="who"><b>{p.name}</b><small>{p.meta}</small><em>{p.note}</em></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="coda wrap" aria-labelledby="coda-h" data-nr data-name="The end" data-desc="Say hello, or go back up">
    <p class="kicker" id="coda-h">that's all for now</p>
    <p class="coda-line">Thanks for scrolling this far. If you're working on something close to this, I'd like to hear about it: <button type="button" class="copy inline" data-copy={EMAIL}><span>{EMAIL}</span><i aria-hidden="true">copy</i></button>.</p>
    <button class="rewind" type="button">back to the top <span aria-hidden="true">↑</span></button>
  </section>
</Base>
