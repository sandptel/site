---
import Base from '../../layouts/Base.astro';
import { JOURNEY } from '../../data/journey';
import { renderBranch } from '../../lib/ui';

// every project card from the journey, newest first, without the tree
// (nested branches only live in the journey, so their words become plain text here)
const flat = (type: string) => JOURNEY.slice().reverse().flatMap(s => Object.entries(s.cards))
  .filter(([, b]) => b.type === type)
  .map(([id, b]) => renderBranch(id, { ...b, subs: undefined, want: undefined })
    .replace('class="bpos', 'class="bpos landed')
    .replace('class="card t-project', 'class="card t-project open')
    .replace(/<button class="tw sub"[^>]*>(.*?)<\/button>/g, '$1'));
const cards = flat('project'), leaves = flat('leaf');
---
<Base title="Projects">
  <section class="list-page wrap">
    <h1>Projects</h1>
    <p>Everything from the journey, newest first.</p>
    <ul class="projects">{cards.map(c => <li set:html={c} />)}</ul>
    <h2 class="sec-h small-branches">Smaller things</h2>
    <ul class="projects">{leaves.map(c => <li set:html={c} />)}</ul>
  </section>
</Base>
